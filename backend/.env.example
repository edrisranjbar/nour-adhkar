APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Resend Configuration
RESEND_API_KEY=re_xxxxxxxxx  # Get from https://resend.com/api-keys

# Mail Configuration
MAIL_MAILER=resend
MAIL_FROM_ADDRESS=noreply@adhkar.ir  # Must be verified domain
MAIL_FROM_NAME="اذکار نور"
GOOGLE_CLIENT_IDS=
GOOGLE_JWKS_PUSH_TOKEN=

# Proxies whose X-Forwarded-For is trusted (the ArvanCloud CDN). "*" trusts any; narrow to the CDN ranges if the origin is reachable directly.
TRUSTED_PROXIES=*

# Android package id used to read the install counts shown on the admin dashboard (see STORE_STATS.md)
STORE_PACKAGE=ir.adhkar.app
